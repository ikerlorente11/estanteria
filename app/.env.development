# Development only (expo start). The web view loads the page from Vite on the PC, with hot reload, through
# `adb reverse tcp:5173 tcp:5173`. In Expo Go (no native module) the host is devhost/server.mjs on the PC too,
# through `adb reverse tcp:48123 tcp:48123`; in a dev client build the native host on the device is used instead.
EXPO_PUBLIC_VIEWER_URL=http://localhost:5173
EXPO_PUBLIC_HOST_URL=http://localhost:48123
EXPO_PUBLIC_HOST_TOKEN=dev
