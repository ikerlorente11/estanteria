{
  "expo": {
    "name": "La Estantería",
    "slug": "estanteria",
    "version": "0.2.0",
    "orientation": "default",
    "scheme": "estanteria",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
