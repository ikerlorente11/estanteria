<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- «solo con wifi»: whether the network a download would use is metered (Wifi.kt) -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <application>
    <!-- «Compartir» a file: the share sheet reads the copy in the cache through this (Files.kt) -->
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.estanteria.compartir"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/estanteria_compartir" />
    </provider>
  </application>
</manifest>
