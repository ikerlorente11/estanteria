{
  "name": "estanteria-android",
  "version": "0.1.0",
  "private": true,
  "description": "La Estantería para Android: lee tus cómics y libros de El Archivador (Expo; el visor compartido en un WebView y un host nativo)",
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "web:build": "npm --prefix web run build",
    "eas-build-post-install": "npm --prefix ../viewer install --no-audit --no-fund && npm --prefix web install --no-audit --no-fund && npm run web:build",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@types/react": "~19.3.0",
    "expo": "^58.0.0",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-intent-launcher": "~58.0.3",
    "expo-keep-awake": "~58.0.3",
    "expo-navigation-bar": "~58.0.4",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-webview": "14.0.1",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "typescript": "~6.0.3"
  }
}
